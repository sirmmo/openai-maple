# Copy to .env and edit. All values are optional.

# Bind address / port.
MAPLE_HOST=0.0.0.0
MAPLE_PORT=8000

# Require `Authorization: Bearer <key>`. Unset = open server.
# MAPLE_API_KEY=sk-local-maple

# HuggingFace repo id or a local directory with the weights.
MAPLE_MODEL_PATH=deepgrove/maple-preview
# Model id advertised by GET /v1/models and echoed in responses.
MAPLE_MODEL_ID=maple-preview
# 404 requests naming any other model. Off so clients hard-coding "gpt-4o" work.
MAPLE_STRICT_MODEL=false

# auto | cpu | cuda | cuda:0 | mps
MAPLE_DEVICE=auto
# auto (= bfloat16) | bfloat16 | float16 | float32
MAPLE_DTYPE=auto
# torch intra-op threads for CPU inference; 0 = torch default (all cores).
MAPLE_TORCH_THREADS=0
# Pack the ternary expert weights as int8 + row scale and compute in fp32.
# auto = on for CPU (halves RAM, ~10x faster on CPUs without bf16 support).
MAPLE_PACK_EXPERTS=auto

# Default and hard ceiling for max_tokens; reasoning traces run long.
MAPLE_MAX_NEW_TOKENS=4096
MAPLE_MAX_NEW_TOKENS_LIMIT=32768
# Reject prompts longer than this many tokens.
MAPLE_MAX_PROMPT_TOKENS=65536

# Sampling defaults when a request omits the field.
MAPLE_TEMPERATURE=0.6
MAPLE_TOP_P=0.95
MAPLE_TOP_K=20

# Let the model reason in a <think> block before answering (default), and
# expose that block as `reasoning_content` on responses.
MAPLE_ENABLE_THINKING=true
MAPLE_INCLUDE_REASONING=true

# One generation at a time; reject past this backlog / wait time.
MAPLE_MAX_QUEUE_DEPTH=16
MAPLE_QUEUE_TIMEOUT=600

# CORS. Comma-separated, or * for any origin.
MAPLE_ALLOWED_ORIGINS=*

MAPLE_LOG_LEVEL=info

# Avoids anonymous HuggingFace rate limits on the first download.
# HF_TOKEN=hf_...
